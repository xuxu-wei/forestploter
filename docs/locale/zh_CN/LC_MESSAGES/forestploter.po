msgstr "**role**"

#: forestploter.layout.ForestColumn:-1 of
#, python-brace-format
msgid "{\"text\", \"numeric\", \"ci\"}"
msgstr "{\"text\", \"numeric\", \"ci\"}"

#: forestploter.layout.ForestColumn:16 of
msgid ""
"Rendering role. The first two draw cell text; ``\"ci\"`` draws point "
"estimates and intervals."
msgstr "渲染角色。前两个绘制单元格文本； ``\"ci\"`` 绘制点估计和区间。"

#: forestploter.layout.ForestColumn:19 of
msgid "**width**"
msgstr "**width**"

#: forestploter.layout.ForestColumn:20 of
